FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --system acoustic \
    && useradd --system --gid acoustic --home-dir /app acoustic \
    && mkdir -p /app/var/storage \
    && chown -R acoustic:acoustic /app

COPY --chown=acoustic:acoustic acoustic_core/ acoustic_core/
COPY --chown=acoustic:acoustic acoustic_numerics/ acoustic_numerics/
COPY --chown=acoustic:acoustic api/ api/
COPY --chown=acoustic:acoustic worker/ worker/
COPY --chown=acoustic:acoustic alembic.ini ./
COPY --chown=acoustic:acoustic migrations/ migrations/

USER acoustic

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3)"

CMD ["sh", "-c", "python -m api.admin init-db && alembic upgrade head && exec uvicorn api.main:app --host 0.0.0.0 --port 8000"]
